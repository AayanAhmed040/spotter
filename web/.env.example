# Copy to .env.local and fill in from your Auth0 dashboard.
# These are PUBLIC identifiers (no secrets) — the SPA uses PKCE, not a client secret.
VITE_AUTH0_DOMAIN=dev-2obhx0olxyz5kjjf.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
# Must exactly match the Identifier of the Auth0 API you create (and AUTH0_AUDIENCE in api/.env)
VITE_AUTH0_AUDIENCE=https://striq/

# Leave empty in dev (Vite proxies /api to the FastAPI server).
# In production set to your deployed API origin, e.g. https://api.yourdomain.com
VITE_API_URL=
