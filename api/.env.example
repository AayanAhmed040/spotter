# Copy to api/.env — this file is gitignored. Never commit real values.

# Auth0: your tenant domain (no https://) and the Identifier of the API you created.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.striqs.health

# Leave as-is for local SQLite, or paste a Postgres URL (Supabase, Tiger Cloud, Neon…).
# Supabase: Project → Connect → "Session pooler" connection string.
DATABASE_URL=sqlite:///./spotter.db

# Browser origins allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# Optional. Without a key, insights/challenges use clearly-labelled rule-based text.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
